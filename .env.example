# Copy to .env.local for local work. In Vercel, add these under Project Settings > Environment Variables.

# Kit (email signup). Create a v4 API key in Kit under Settings > Developer, and a form for the signup.
# Server only: never prefix these with NEXT_PUBLIC_.
KIT_API_KEY=
KIT_FORM_ID=

# Optional: override the Cal.com event ("username/event-slug"). Defaults to vikypediaa/20-min-intro-with-vikas.
# NEXT_PUBLIC_CAL_LINK=
